{
  "name": "memeforge",
  "version": "1.0.0",
  "private": true,
  "description": "MemeForge — personal crypto intelligence, portfolio management, market analysis & automation platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web,bot -c blue,magenta,cyan \"npm:dev:api\" \"npm:dev:web\" \"npm:dev:bot\"",
    "dev:api": "npm run dev -w @memeforge/api",
    "dev:web": "npm run dev -w @memeforge/web",
    "dev:bot": "npm run dev -w @memeforge/bot",
    "build": "npm run build -w @memeforge/shared && npm run build -w @memeforge/api && npm run build -w @memeforge/web && npm run build -w @memeforge/bot",
    "build:api": "npm run build -w @memeforge/api",
    "build:web": "npm run build -w @memeforge/web",
    "db:generate": "npm run db:generate -w @memeforge/api",
    "db:migrate": "npm run db:migrate -w @memeforge/api",
    "db:seed": "npm run db:seed -w @memeforge/api",
    "db:studio": "npm run db:studio -w @memeforge/api",
    "lint": "echo \"lint: configure per-workspace\"",
    "typecheck": "npm run typecheck -w @memeforge/api && npm run typecheck -w @memeforge/web"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
