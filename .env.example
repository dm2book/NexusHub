#######################################################################
# MemeForge — Environment Configuration
# Copy this file to `.env` and fill in the values.
# A fresh checkout runs end-to-end with mock data using only the
# values already provided below (no external keys required).
#######################################################################

# ---- Core ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://memeforge:memeforge@localhost:5432/memeforge?schema=public

# ---- Auth / Security ----
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# The single platform owner. The first user with this email becomes OWNER.
OWNER_EMAIL=mohamedelhannouti51@gmail.com

# ---- OAuth ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:4000/api/v1/auth

# ---- Data providers (leave blank to use the built-in mock engine) ----
DATA_PROVIDER=mock            # mock | dexscreener | birdeye
BIRDEYE_API_KEY=
HELIUS_API_KEY=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- AI Brain ----
AI_PROVIDER=heuristic         # heuristic | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=MemeForge <alerts@memeforge.local>

# ---- Discord Bot ----
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERT_CHANNEL_ID=
DISCORD_BOT_CLIENT_ID=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Web Push (VAPID) ----
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@memeforge.local

# ---- Feature flags ----
ENABLE_AUTOMATION=true
ENABLE_BOT=false
ENABLE_CRON=true
