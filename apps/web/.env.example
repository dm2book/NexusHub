# Web app environment (Next.js public vars)
#
# All-on-Vercel deployment: leave API base URL UNSET (API is same-origin) and
# realtime disabled (polling is used on serverless).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_REALTIME=0
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Separate always-on API instead? Point at it and enable WebSocket realtime:
# NEXT_PUBLIC_API_BASE_URL=https://your-api.onrender.com
# NEXT_PUBLIC_REALTIME=1
