# Discord bot — create an app at https://discord.com/developers/applications
DISCORD_TOKEN=                 # Bot token (Bot tab)
DISCORD_CLIENT_ID=            # Application (client) ID
DISCORD_GUILD_ID=            # Your server ID (enable Developer Mode → right-click server → Copy ID)

# AI assistant (optional but recommended). Without it, the bot uses a rule-based
# FAQ fallback so it still works.
ANTHROPIC_API_KEY=           # sk-ant-...
AI_MODEL=claude-sonnet-4-6

# Connect product recommendations + order lookups to your live store (optional).
FORGEMARKET_API_URL=         # https://forgemarket.nl
STORE_URL=                   # https://forgemarket.nl

# Shared secret for the signed store relay: the bot polls the outbox (order
# pings, drops, delivery DMs) and reads /balance & /digest with it. MUST be the
# exact same value as REVIEW_INGEST_SECRET in your Vercel project, or those
# features stay off and the launch check shows Discord as not connected.
REVIEW_INGEST_SECRET=

# Where order/lead notifications are posted (auto-filled by setup.js if blank).
STAFF_LOG_CHANNEL_ID=

# Public Trustpilot profile, e.g. https://nl.trustpilot.com/review/forgemarket.nl
# Leave blank until the profile actually exists: the #links and #reviews panels,
# their buttons and the /vouch follow-up all render the Trustpilot line only when
# this is set, so nobody is ever sent to a 404 from the anti-scam channel.
TRUSTPILOT_URL=
# The "write a review" form, used by the /vouch follow-up. Derived from the
# profile above when blank (/review/ -> /evaluate/).
TRUSTPILOT_REVIEW_URL=
