# Discord bot — create an app at https://discord.com/developers/applications
DISCORD_TOKEN=                 # Bot token (Bot tab)
DISCORD_CLIENT_ID=            # Application (client) ID
DISCORD_GUILD_ID=            # Your server ID (enable Developer Mode → right-click server → Copy ID)

# AI assistant (optional but recommended). Without it, the bot uses a rule-based
# FAQ fallback so it still works.
ANTHROPIC_API_KEY=           # sk-ant-...
AI_MODEL=claude-sonnet-4-6

# Connect product recommendations + order lookups to your live store (optional).
FORGEMARKET_API_URL=         # https://your-forgemarket-api.vercel.app
STORE_URL=                   # https://your-store.vercel.app

# Where order/lead notifications are posted (auto-filled by setup.js if blank).
STAFF_LOG_CHANNEL_ID=
