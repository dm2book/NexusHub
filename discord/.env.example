# ForgeMarket Discord bot — environment
#
# Copy to .env for a local run; on Railway set these as service variables
# instead (see README.md → Railway). Never commit a filled-in copy.
#
# GENERATED from ENV_SPEC in src/runtime.js — the same list the bot validates
# against at startup, so this file cannot drift from what the code expects.
# Regenerate with: npm run env:example

# --- Required ---------------------------------------------------------
# Bot token — Developer Portal → your app → Bot → Reset Token.
DISCORD_TOKEN=

# Your server id (right-click the server → Copy Server ID). The bot only
# works in this guild and leaves any other one it is added to.
DISCORD_GUILD_ID=

# --- Strongly recommended: without these, features silently stay off ---
# Application ID. Needed by `npm run invite` and command registration.
# DISCORD_APPLICATION_ID is accepted as an alias.
DISCORD_CLIENT_ID=

# Comma-separated Discord user ids allowed to run owner commands
# (/paylink, /digest, /stock, /launch, /coupon, /announce). Without it
# only members with Manage Server can.
DISCORD_OWNER_IDS=

# Your storefront, e.g. https://forgemarket.nl. Every link the bot posts
# starts here.
STORE_URL=

# Usually the same as STORE_URL. Without it /price, /order and the relay
# are off.
FORGEMARKET_API_URL=

# Must match the value in Vercel exactly, or the store relay stays silent:
# no order pings, no drops, no delivery DMs, and no durable state.
REVIEW_INGEST_SECRET=

# --- Optional ---------------------------------------------------------
# AI answers in #ask-the-bot. Without it a rule-based FAQ answers instead.
ANTHROPIC_API_KEY=

# Defaults to claude-sonnet-4-6.
AI_MODEL=

# Invite shown by /invite until the bot has made its own permanent one. No
# default: unset, /invite says the link is not ready yet.
DISCORD_INVITE_URL=

# Separate shared secret for /paylink (must match the API’s
# DISCORD_PAYLINK_SECRET). Unset = /paylink is disabled.
DISCORD_PAYLINK_SECRET=

# Optional comma-separated extra check for /paylink hosts (e.g.
# tikkie.me,bunq.me). The API always enforces its own payment-host
# allow-list.
PAYLINK_HOSTS=

# When the one-off launch announcement may post (ISO time). Default
# 2026-10-23T22:00:00Z (24 Oct 00:00 Amsterdam). Posted once, never before
# this moment.
LAUNCH_DATE=

# Maximum AI answers per day across the server (/ask, /recommend,
# #ask-the-bot). Default 300.
AI_DAILY_CAP=

# Support availability text shown in #support-info. Default: "Elke dag,
# reactie meestal binnen 24 uur (NL tijd)".
SUPPORT_HOURS=

# Usually leave blank: the bot reads the profile from the website’s
# /api/config, so setting it there is enough. Set it here only to override
# that.
TRUSTPILOT_URL=

# Derived from TRUSTPILOT_URL when blank.
TRUSTPILOT_REVIEW_URL=

# Health endpoint port. Railway sets this for you; leave it unset on
# PebbleHost.
PORT=

# debug | info | warn | error. Default info.
LOG_LEVEL=

# json | pretty. Default: pretty on a terminal, json otherwise.
LOG_FORMAT=

# One-off, for `npm run setup` only: re-post every panel. Never set on the
# host.
REPOST=

# One-off, for `npm run setup` only: PRUNE=off reports strays instead of
# removing them.
PRUNE=

# Alias for DISCORD_CLIENT_ID. Set either one, not both.
DISCORD_APPLICATION_ID=
