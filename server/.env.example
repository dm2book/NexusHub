# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000          # storefront SPA origin (CORS + links)
API_URL=http://localhost:4000          # this API's public origin (OAuth redirects)

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Vercel Postgres sets POSTGRES_URL automatically. Locally / elsewhere use
# DATABASE_URL. Use a POOLED connection string in serverless (Neon/Vercel pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/forgemarket
DATABASE_SSL=false                     # true for hosted DBs (Neon/Vercel/Supabase)

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
ADMIN_EMAILS=                                   # comma-separated; these logins become owner/admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── OAuth providers (leave blank to disable a provider) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord community ────────────────────────────────────────────────────────
DISCORD_SERVER_NAME=ForgeMarket Community
DISCORD_TAGLINE=Drops, giveaways, support & vouches.
DISCORD_GUILD_ID=                      # enables LIVE stats via the server Widget
DISCORD_INVITE_URL=https://discord.gg/vNcfgDbVd   # the Join button link
DISCORD_ORDER_WEBHOOK_URL=             # posts order events to an ops channel
DISCORD_DROPS_WEBHOOK_URL=             # public #deals webhook: new products, restocks, coupons, bundles
DISCORD_STOCK_WEBHOOK_URL=             # staff low-stock alerts (falls back to the order webhook)
LOW_STOCK_THRESHOLD=5                  # alert when a product has fewer codes left than this
DISCORD_BOT_TOKEN=                     # grant buyer roles (Verified/VIP), loyalty roles + delivery DMs via the API
DISCORD_VIP_THRESHOLD_CENTS=2000       # spend ≥ this (€20) → VIP Customer

# ── Email ────────────────────────────────────────────────────────────────────
# RECOMMENDED on Vercel/serverless: set RESEND_API_KEY (HTTP API — reliable).
# Raw SMTP from serverless functions is often slow or blocked.
RESEND_API_KEY=                        # re_xxxxxxxx  (Resend → API Keys)
# Alternative: full SMTP URL. If it's a Resend URL the API key is auto-detected.
SMTP_URL=                              # e.g. smtps://resend:re_xxx@smtp.resend.com:465
EMAIL_FROM_NAME=ForgeMarket
# onboarding@resend.dev works without verifying a domain, BUT Resend only delivers
# it to YOUR OWN Resend account email until you verify a domain. To email any
# customer, verify a domain in Resend and set this to e.g. no-reply@yourdomain.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_BRAND_COLOR=#6366f1
EMAIL_LOGO_URL=

# ── Shop ─────────────────────────────────────────────────────────────────────
COUPONS=                               # discount codes "FORGE10:10,WELCOME5:5" (CODE:percent)
SITE_ANNOUNCEMENT=                     # optional promo bar text shown across the site

# ── Payments ─────────────────────────────────────────────────────────────────
# Manual methods (Tikkie / Revolut / PayPal). If ANY are set, the storefront uses
# them: the customer pays via the link with their order number as reference, and
# you confirm the order in /admin → Orders. Easiest way to start selling in NL.
PAY_TIKKIE=                            # your Tikkie payment-request link
PAY_REVOLUT=                           # revolut.me/yourname
PAY_PAYPAL=                            # paypal.me/yourname  OR  your-paypal@email.com
PAY_NOTE=                              # optional note shown on the pay screen
# Or real card payments via Stripe Checkout (used only if no manual methods set):
STRIPE_SECRET_KEY=                     # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=                 # whsec_…  (from the Stripe webhook config)

# Demo mode lets the storefront mark orders paid without a real PSP so the full
# order → fulfillment loop works. Defaults ON outside production. Ignored when
# Stripe is configured.
DEMO_PAYMENTS=

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
FRAUD_REVIEW_THRESHOLD=60
FRAUD_BLOCK_THRESHOLD=85
