# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000          # storefront SPA origin (CORS + links)
API_URL=http://localhost:4000          # this API's public origin (OAuth redirects)

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Vercel Postgres sets POSTGRES_URL automatically. Locally / elsewhere use
# DATABASE_URL. Use a POOLED connection string in serverless (Neon/Vercel pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/forgemarket
DATABASE_SSL=false                     # true for hosted DBs (Neon/Vercel/Supabase)

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
ADMIN_EMAILS=                                   # comma-separated; these logins become owner/admin
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── OAuth providers (leave blank to disable a provider) ──────────────────────
# Blank is a supported state: the storefront hides the button entirely rather
# than offering a login that cannot complete. Email one-time codes keep working.
#
# Discord: https://discord.com/developers/applications → your app → OAuth2.
# The redirect URL must match EXACTLY, including https and no trailing slash:
#   <API_URL>/api/auth/oauth/discord/callback
# Same shape for Google, in the Cloud console under Credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord support server ───────────────────────────────────────────────────
DISCORD_SERVER_NAME=ForgeMarket Support
DISCORD_TAGLINE=Order help, delivery updates, drops & giveaways.
DISCORD_GUILD_ID=                      # enables LIVE stats via the server Widget
DISCORD_INVITE_URL=https://discord.gg/vNcfgDbVd   # the Join button link
DISCORD_ORDER_WEBHOOK_URL=             # posts order events to an ops channel
DISCORD_DROPS_WEBHOOK_URL=             # public #deals webhook: new products, restocks, coupons, bundles
DISCORD_STOCK_WEBHOOK_URL=             # staff low-stock alerts (falls back to the order webhook)
LOW_STOCK_THRESHOLD=5                  # alert when a product has fewer codes left than this
DISCORD_BOT_TOKEN=                     # grant buyer roles (Verified/VIP), loyalty roles + delivery DMs via the API
# LIFETIME paid spend at or above which a buyer becomes VIP. Lifetime, not per
# order: this used to compare a single order total, so someone who spent €500
# across twenty orders was never VIP while one €20 order was.
DISCORD_VIP_THRESHOLD_CENTS=20000      # €200 lifetime → VIP Customer
# The role names the site manages, matched in your server BY NAME. Change these
# if your server already has roles with different names — otherwise you end up
# with duplicates. Anything not present in the guild is skipped and reported at
# Admin → Security; the same screen can create the missing ones for you.
DISCORD_ROLE_CUSTOMER=                 # default: Verified Customer
DISCORD_ROLE_VIP=                      # default: VIP Customer
DISCORD_ROLE_REVIEW=                   # default: Reviewer
# Loyalty roles (Bronze / Silver / Gold / Platinum) use the tier names and are
# managed the same way.

# ── Owner alerts (paid, failed, refund, chargeback, low stock) ───────────────
# The "something happened to my money" channel — yours, not the customer's.
# Every channel is optional and independent: set the one you actually read.
# Nothing set means nothing is sent; the shop is unaffected either way.
#
# These arrive in SECONDS. DISCORD_ORDER_WEBHOOK_URL above is a different path:
# with no webhook URL those events queue for the bot, which polls once a minute.
# Fine for a log, too slow for "someone just paid".
#
# Discord: Server Settings → Integrations → Webhooks → New Webhook → Copy URL.
# Falls back to DISCORD_ORDER_WEBHOOK_URL when left blank, so an existing ops
# channel keeps working; set this to send the alerts somewhere private instead.
NOTIFY_DISCORD_WEBHOOK_URL=
# Telegram: message @BotFather → /newbot → copy the token. Then message your own
# bot once and open https://api.telegram.org/bot<TOKEN>/getUpdates to read your
# chat id (a number; negative for a group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Pushover: the one that gets through a silent phone. pushover.net → your user
# key is on the dashboard, then "Create an Application" for the API token.
# A chargeback goes out at high priority and low stock below normal, so the
# alert that costs money is the one that makes a sound.
PUSHOVER_TOKEN=
PUSHOVER_USER=

# ── Email ────────────────────────────────────────────────────────────────────
# RECOMMENDED on Vercel/serverless: set RESEND_API_KEY (HTTP API — reliable).
# Raw SMTP from serverless functions is often slow or blocked.
RESEND_API_KEY=                        # re_xxxxxxxx  (Resend → API Keys)
# Alternative: full SMTP URL. If it's a Resend URL the API key is auto-detected.
SMTP_URL=                              # e.g. smtps://resend:re_xxx@smtp.resend.com:465
EMAIL_FROM_NAME=ForgeMarket
# onboarding@resend.dev works without verifying a domain, BUT Resend only delivers
# it to YOUR OWN Resend account email until you verify a domain. To email any
# customer, verify a domain in Resend and set this to e.g. no-reply@yourdomain.
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_BRAND_COLOR=#6366f1
EMAIL_LOGO_URL=

# ── SMS login (optional, and it costs money per message) ─────────────────────
# Leave blank and the storefront simply asks for an email address: the phone
# field, the "add a phone number" panel and the SMS resend all disappear rather
# than promising a text nobody can send. Fill all three in and they come back
# on their own — no code change, no redeploy of the frontend.
# TWILIO_FROM is either a number you rent, or an alphanumeric sender ID
# (e.g. "ForgeMarket") which NL supports and which has no monthly fee.
TWILIO_ACCOUNT_SID=                    # AC........  (Twilio console)
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                           # +31... or an approved sender ID

# ── Shop ─────────────────────────────────────────────────────────────────────
COUPONS=                               # discount codes "FORGE10:10,WELCOME5:5" (CODE:percent)
SITE_ANNOUNCEMENT=                     # optional promo bar text shown across the site
# Public Trustpilot profile, e.g. https://nl.trustpilot.com/review/forgemarket.nl
# Left blank the site shows no Trustpilot link at all, rather than one that 404s.
TRUSTPILOT_URL=
# Where we send someone we are ASKING for a review (the form, not the profile).
# Left blank it is derived from TRUSTPILOT_URL by swapping /review/ for
# /evaluate/, which is Trustpilot's own convention — only fill this in if your
# form lives somewhere else.
TRUSTPILOT_REVIEW_URL=

# ── Payments ─────────────────────────────────────────────────────────────────
# Mollie — iDEAL, Bancontact, Apple Pay, credit card and PayPal through one
# account. When this is set it is the payment method the storefront uses: it is
# the only one that confirms itself (the webhook marks the order paid and stock
# dispenses without anyone reading a bank app).
#
# Create the key at https://my.mollie.com → Developers → API keys. A live_ key
# takes real money; a test_ key never does, and the server REFUSES to start in
# production with one. No webhook secret exists — Mollie's webhook carries no
# signature, so the server fetches every payment from the API before believing
# anything about it.
MOLLIE_API_KEY=                        # live_… in production, test_… locally
# Only needed when the webhook cannot reach you at API_URL — i.e. local
# development. Point it at an ngrok/cloudflared tunnel; Mollie cannot call
# localhost. In production leave this empty: API_URL is correct.
MOLLIE_WEBHOOK_BASE=                   # e.g. https://abc123.ngrok-free.app

# Manual methods (Tikkie / Revolut / PayPal). If ANY are set, the storefront uses
# them: the customer pays via the link with their order number as reference, and
# you confirm the order in /admin → Orders. Easiest way to start selling in NL.
PAY_TIKKIE=                            # your Tikkie payment-request link
PAY_REVOLUT=                           # revolut.me/yourname
PAY_PAYPAL=                            # paypal.me/yourname  OR  your-paypal@email.com
PAY_NOTE=                              # optional note shown on the pay screen
# Or real card payments via Stripe Checkout (used only if no manual methods set):
STRIPE_SECRET_KEY=                     # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=                 # whsec_…  (from the Stripe webhook config)

# Demo mode lets the storefront mark orders paid without a real PSP so the full
# order → fulfillment loop works. Defaults ON outside production. Ignored when
# Stripe is configured.
DEMO_PAYMENTS=

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Fraud scoring. Each rule adds points; the total decides what happens.
#   >= REVIEW  the order is placed and paid, but NO code is delivered until a
#              person approves it in Admin → Security → Fraud review
#   >= BLOCK   the order is refused at checkout, before any money is asked for
#
# Digital goods are the reason review HOLDS rather than merely flags: a code
# cannot be un-read, and the chargeback lands weeks later with nothing to
# reclaim. Lower the review threshold to catch more (and check more by hand);
# raise it to be left alone more.
FRAUD_REVIEW_THRESHOLD=60
FRAUD_BLOCK_THRESHOLD=85

# Hard ceilings, checked before an order is created. Not risk signals — walls.
# Every one of them should be invisible to a real customer; a limit a genuine
# buyer hits is a lost sale, and lost sales appear in no fraud statistic.
# Set any to 0 to switch it off. Amounts are in CENTS.
# The FIRST wall a burst hits — measured, with the daily ceilings below turned
# off entirely, a single address was still refused at order 21. Correct against
# one abusive buyer; also what a school, an office or a mobile carrier looks
# like, since everyone behind one NAT shares an address. Raise it before a drop.
LIMIT_CHECKOUT_PER_MINUTE=20           # orders per minute per IP

LIMIT_ORDERS_PER_EMAIL_DAY=8           # orders per email per rolling 24h
LIMIT_ORDERS_PER_IP_DAY=15             # per IP — looser: households share one
LIMIT_VALUE_PER_EMAIL_DAY=100000       # €1000 of orders per email per 24h
LIMIT_MAX_ORDER_VALUE=50000            # €500 — the ceiling on one mistake
