# ── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000          # storefront SPA origin (CORS + links)
API_URL=http://localhost:4000          # this API's public origin (OAuth redirects)

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Vercel Postgres sets POSTGRES_URL automatically. Locally / elsewhere use
# DATABASE_URL. Use a POOLED connection string in serverless (Neon/Vercel pooler).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/forgemarket
DATABASE_SSL=false                     # true for hosted DBs (Neon/Vercel/Supabase)

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED in production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── OAuth providers (leave blank to disable a provider) ──────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ── Discord community ────────────────────────────────────────────────────────
DISCORD_SERVER_NAME=ForgeMarket Community
DISCORD_TAGLINE=Drops, giveaways, support & vouches.
DISCORD_GUILD_ID=                      # enables LIVE stats via the server Widget
DISCORD_INVITE_URL=                    # https://discord.gg/xxxx  (Join button)
DISCORD_ORDER_WEBHOOK_URL=             # posts order events to an ops channel

# ── Email ────────────────────────────────────────────────────────────────────
# Without SMTP_URL, emails are rendered + recorded in the email_log table.
SMTP_URL=                              # e.g. smtps://user:pass@smtp.host:465
EMAIL_FROM_NAME=ForgeMarket
EMAIL_FROM_ADDRESS=no-reply@forgemarket.app
EMAIL_BRAND_COLOR=#6366f1
EMAIL_LOGO_URL=

# ── Payments ─────────────────────────────────────────────────────────────────
# Demo mode lets the storefront mark orders paid without a real PSP so the full
# order → fulfillment loop works. Defaults ON outside production. Set to true to
# enable on a live deploy (or wire a real provider like Stripe instead).
DEMO_PAYMENTS=

# ── Security ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
FRAUD_REVIEW_THRESHOLD=60
FRAUD_BLOCK_THRESHOLD=85
