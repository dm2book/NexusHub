{
  "name": "forgemarket-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ForgeMarket commerce platform — backend API (auth, orders, suppliers, fulfillment, email, analytics, security).",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
